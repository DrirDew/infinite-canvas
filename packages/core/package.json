{
    "name": "@basketikun/infinite-canvas",
    "version": "0.1.0",
    "description": "Embeddable React infinite canvas engine",
    "keywords": ["canvas", "infinite-canvas", "react", "diagram", "node-editor"],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/basketikun/infinite-canvas.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/basketikun/infinite-canvas#readme",
    "bugs": "https://github.com/basketikun/infinite-canvas/issues",
    "type": "module",
    "sideEffects": false,
    "files": ["dist", "README.md", "LICENSE"],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./headless": {
            "types": "./dist/headless.d.ts",
            "import": "./dist/headless.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "test": "bun test",
        "test:types:headless": "tsc -p test/tsconfig.headless.json"
    },
    "publishConfig": { "access": "public" },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "typescript": "^5"
    }
}
