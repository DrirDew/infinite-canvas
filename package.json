{
    "name": "infinite-canvas-monorepo",
    "private": true,
    "workspaces": ["apps/*", "packages/*", "plugins/user/*", "plugins/registry"],
    "scripts": {
        "dev": "bun --cwd apps/web dev",
        "dev:examples": "bun --cwd apps/examples dev",
        "build": "bun --cwd apps/web build",
        "dev:docs": "bun --cwd apps/docs dev",
        "build:plugins": "bun --cwd plugins/registry build"
    }
}
